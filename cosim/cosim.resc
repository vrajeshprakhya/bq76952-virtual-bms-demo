:name: xezim co-simulation
:description: STM32G0 (the schematic's U2 family) running the real BMS host firmware against the SV-RNM board in xezim

using sysbus

mach create "bms"
machine LoadPlatformDescription @platforms/cpus/stm32g0.repl

include @Bridge.cs
# 0x50000000 is GPIOA on the G0; the bridge lives in the free 0x60000000 region
machine LoadPlatformDescriptionFromString "bridge: XezimBridge @ sysbus 0x60000000"

sysbus LoadELF @fw_arm/fw.elf

usart2 CreateFileBackend $CWD/uart.log true

echo "running: firmware drives the xezim board over the bridge"
emulation RunFor "2"
quit
